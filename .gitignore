# Ignore symlinks to external tools/checkouts -- these resolve by absolute
# path on this machine only; see docs/guides/dev-environment.md for the
# one-line `ln -s` setup each of them needs on a fresh clone.
tools/trsextract
/sdl2trs
/run-5-calvados-omti-hd.command

# Ignore build output
build/

# Ad hoc pasmo assemble output (Z80: Assemble with Pasmo task).
# src/hd-driver/omti/hdtest.sym and hdwtest.sym, src/patchdisk/PATCH.CMD,
# and src/GDOS-2.4-HD-tools/HDFORMAT.CMD and GENDIR.CMD (stock GDOS 2.4
# binaries, extracted not assembled) are deliberately tracked and stay
# tracked regardless of this pattern.
*.cmd
*.sym

# Scratch disks/logs from run-stock-session.sh
/work/

# Local-only developer notes, not meant to be published to GitHub
/docs/guides/

# Python bytecode cache (tools/*.py, tools/zbx-dap/adapter.py)
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store

# Ignore temporary files
*.tmp
*.bak
