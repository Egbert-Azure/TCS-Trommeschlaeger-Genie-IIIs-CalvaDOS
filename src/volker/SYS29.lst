44          	DEFM	'DISKF:',14h,28h,07h,28h,14h,04h,00h,44h,14h,02h
44          	DEFM	'DISKG:',18h,30h,53h,28h,12h,03h,00h,07h,18h,02h
44          	DEFM	'DISKH:',18h,30h,53h,28h,24h,06h,00h,41h,18h,02h
44          	DEFM	'DISKI:',28h,50h,07h,50h,0ah,02h,00h,00h,28h,02h
