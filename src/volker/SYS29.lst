            ;	diverse Texte und Puffer:
            ;
            ;	Codes > 80h wiederholen das nächste Zeichen (x-128)mal
            ;
            ;	"@" steht für "(umgeleitet)" bei Routing
            ;
            ;	Anzeige für Port F3 (Systembyte 2, Label portf3):
            ;	"Bank":		Hauptspeicher-Block	(Bits 0, 1)
            ;	"Vid.":		Video-RAM-Block		(Bits 2, 3)
            ;	"Grph.":	Graphik-Block		(Bits 4, 5)
            ;	"C":		Common-Definintion:
            ;			Bit 7	= 0:	1X Common für 1 MB
            ;				= 1:	4X Common für je 256 kB
            ;	"E&R":		Baustein in 0000-2FFF bei Port FA, Bit 2 = 0:
            ;			Bit 6	= 0:	Boot-EPROM selektiert
            ;				= 1:	parall. SRAM	"
            
28          m50f4	DEFM	'(umgeleitet)',03h	;falls Routing eines Device
10          m5101	DEFM	10h,1ch,1fh		;16*64 Zeichen (bedingt), CLS
98          	DEFM	98h,'- GENIE-DOS INFO ',98h,'-',0bh,'Tastatur: '
46          m5123	DEFM	'FFFFh @  Ende User-RAM (HIMEM): '	;@ für "(umgel.)"
46          m5142	DEFM	'FFFFh',0ah,'Monitor:  '
46          m5152	DEFM	'FFFFh @  '
4B          m515b	DEFM	'Kopf-/Fußzeilen:',87h,' '
30          m5177	DEFM	'00h/00h',0ah,'Drucker:  '
46          portf3	DEFM	'FFFFh @  Bank/Vid./Grph./C/E&R: '
30          m51a2	DEFM	'0/0/0/0/0',0ah,99h,'- ZEICHENSATZ ',9ah,'-',0bh,03h
99          m51b9	DEFM	99h,'- AKTIVE PORTS ',99h,'-',0bh,03h
20          m51cd	DEFM	' '
30          m51ce	DEFM	'00='
30          m51d1	DEFM	'00 ',03h
            
            ;
            ;
            ;
            ;
            ;
            ;		Eingefügt am 29.02.92
            ;	ADDIEREN VON ZWEI HEXZAHLEN
            ;
            ;  mit Hilfe des DOS-Unterprogramms bei 3B68h
            ;
            ;
            ;
            ;   die dezimalausgabe ist von zeus abgekuckt und läuft
            ;   über eine basic-unterprogramm
            ;
            ;
            mmein	EQU	06abh
            mmaus	EQU	06a0h
            conver	EQU	3b68h
            gibaus	EQU	4467h
            hexde	EQU	4063h
            ;
7E          add	LD	A,(HL)		; wenn zunächst ein '@' eingegeben wird
FE 40       	CP	'@'		; dann soll ein weitere Zahl zu dem
23          	INC	HL
28 0E       	JR	Z,wei2		; vorhererrechneten addiert oder subtr.
2B          	DEC	HL		; ist nötig den Zeiger zu verändern.
CD A0 06    	CALL	mmaus
CD 68 3B    	CALL	conver
CD AB 06    	CALL	mmein		; das ergebnis ist jetzt in DE
ED 53 5E 43 	LD	(ergeb),DE	; abspeichern
7E          wei2	LD	A,(HL)		; kommt jetzt ein '+' ??
FE 0D       	CP	0dh		; enter heißt nur eine Zahl
28 29       	JR	Z,einzah
FE 2D       	CP	'-'		; soll subtrahiert werden ?
20 0C       	JR	NZ,wei1		; falls nicht
E5          	PUSH	HL		; befehlszeiger retten !!
21 4F 51    	LD	HL,opera	; operationscodestelle
36 ED       	LD	(HL),0edh	; opcode für SBC  HL,DE
23          	INC	HL
36 52       	LD	(HL),52h
E1          	POP	HL		; befehlszeiger zurück
18 07       	JR	goon
FE 2B       wei1	CP	'+'
3E 2F       	LD	A,2fh
C2 1E 4E    	JP	NZ,errsynt	; sonst fehler
CD A0 06    goon	CALL	mmaus
23          	INC	HL
CD 68 3B    	CALL	conver		; HL zeigt auf zweite zahl
CD AB 06    	CALL	mmein
2A 5E 43    	LD	HL,(ergeb)	; HL = erste Zahl
19          opera	ADD	HL,DE		; addition
00          	NOP			; weil SBC ein zweibytebefehl ist
22 5E 43    	LD	(ergeb),HL	; und speichern
2A 5E 43    einzah	LD	HL,(ergeb)
CD 76 51    	CALL	dezhl
21 6F 51    	LD	HL,hexbuf
ED 5B 5E 43 	LD	DE,(ergeb)
CD 63 40    	CALL	hexde
21 6B 51    	LD	HL,hexbuf1
CD 67 44    	CALL	gibaus
C9          	RET			; normaler Abgang bei SYS-Files
64          hexbuf1	DEFM	'd : '
66          hexbuf	DEFM	'ffffh ',0dh
            ergeb	EQU	435eh
            ;
            ;	HL als Integer auf den Bildschirm
            ;
22 21 41    dezhl	LD	(4121h),HL	;Integer-X-Register
21 30 41    	LD	HL,4130h	;Buffer
CD 2F 13    	CALL	132fh		;Integer auf Screen
36 03       	LD	(HL),03h	;statt 0: enter ans Ende des Ziffernstr.
21 30 41    	LD	HL,4130h
CD 67 44    	CALL	gibaus
C9          	RET
            
            ;
            ;
            ;
            ;	ON
            ;	SCHALTET DIE HRG SEITE 0 EIN
            ;	FUER GENIE IIIs
DB FA       hrgon	IN	A,(0fah)	;systembyte 1
CB CF       	SET	1,A	;grafik an/aus-bit
D3 FA       	OUT	(0fah),A	;raus damit
C9          	RET     	; normaler Ausgang für DOS
            ;
            ;
            
            ;	O F F
            ;	schaltet die grafik aus
            ;	fuer Genie IIIs
DB FA       hrgoff	IN	A,(0fah)
CB 8F       	RES  	1,A
D3 FA       	OUT	(0fah),A
C9          	RET
            ;
            ;	PARK parkt die Köpfe der harddisk auf Cylinderposition
            ;	612, um die Köpfe von der Platte in Sicherheit zu bringen
            ; 	nach diversen Programmen zusammengestückelt, u.a. c't'
            ;	sowie H.Bernhardt und A. Magnus
            ;
            m0503	EQU	0503h
            m050b	EQU	050bh
            m402d	EQU	402dh
D3 42       m5200	OUT	(42h),A
CD 12 52    	CALL	m5212
79          	LD	A,C
D3 40       	OUT	(40h),A
0E 40       	LD	C,'@'
CD 12 52    m520a	CALL	m5212
ED A3       	OUTI
20 F9       	JR	NZ,m520a
C9          	RET
DB 41       m5212	IN	A,(41h)
CB 47       	BIT	0,A
28 FA       	JR	Z,m5212
C9          	RET
00          m5247	NOP
80          	ADD	A,B
60          	LD	H,B
00          	NOP
02          	LD	(BC),A
21 2E 52    park	LD	HL,text
CD 67 44    	CALL	m4467
21 19 52    	LD	HL,m5247
01 0B 05    	LD	BC,m050b
CD 00 52    	CALL	m5200
C9          	RET		; Ausstieg bei SYS-Files
48          text	DEFM	'HD parked on Cyl. 612.',0dh
            mffff	EQU	0ffffh
            	END	sys29
