44          	DEFM	'DISKP:',11h,4ah,50h,52h,12h,04h,00h,03h,11h,06h
            
FE FF       sys29	CP	0ffh		;der richtige Requestcode?
20 1B       	JR	NZ,errfunc	;falls nein
0D          	DEC	C		;Hühnerleiter der SYS29-Features
28 1F       	JR	Z,info		;falls INFO-Befehl
0D          	DEC	C		;PORT-Befehl?
CA 3F 4F    	JP	Z,port
0D          	DEC	C		;DISK-Befehl?
CA C4 4F    	JP	Z,disk
0D          	DEC	C		; H ? addieren & subtrahieren von
CA 12 51    	JP	Z,add		; INTEGER-Zahlen
0D          	DEC	C		; ON ?  HRG einschalten
CA 88 51    	JP	Z,hrgon
0D          	DEC	C		; OFF ? HRG ausschalten
CA 8F 51    	JP	Z,hrgoff
0D          	DEC	C		; PARK ?? Harddisk parken
CA 1E 52    	JP	Z,park
3E 2A       errfunc	LD	A,2ah		;Fehlercode "unzulässige DOS-Funktion"
C9          	RET
3E 34       errsynt	LD	A,34h		;Fehlercode "Syntax o. Trennzeichen ..."
B7          	OR	A		;NZ-Flag für Fehlerbedingung setzen
C9          	RET
            
CD D5 4C    info	CALL	m4cd5		;Zeiger auf Zeichen nach dem Befehlswort
