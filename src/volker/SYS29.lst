E6 7F       	AND	7fh		;Bit 7 löschen
47          	LD	B,A		;Zähler für die Blanks
23          	INC	HL		;nächste Stelle des Textes
7E          m4ea5	LD	A,(HL)		;nächstes Byte
FE 03       	CP	03h		;Textende?
