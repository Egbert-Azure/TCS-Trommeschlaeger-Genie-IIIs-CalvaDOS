21 2D 50    	LD	HL,m50f4	;Text "(umgeleitet)"
CD 67 44    	CALL	m4467		;anzeigen
E1          	POP	HL
AF          	XOR	A
FE 0B       m4eb6	CP	0bh		;bedingter LF? (je nach Videoformat)
20 02       	JR	NZ,m4ebc	;falls nein
3E 0A       	LD	A,0ah		;LF daraus machen (oder NUL bei < 64 Z.)
            m4ebb	EQU	$-1
F5          m4ebc	PUSH	AF
CD 33 00    	CALL	m0033		;Byte anzeigen
F1          	POP	AF
FE 0D       	CP	0dh		;war es CR?
C8          	RET	Z		;falls ja
