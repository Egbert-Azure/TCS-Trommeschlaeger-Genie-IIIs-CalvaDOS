B2          	OR	D		;binär -> ASCII
77          	LD	(HL),A		;in den Puffer schreiben
23          	INC	HL		;auf nächste Pufferstelle
23          	INC	HL
CB 0B       	RRC	E		;zwei weitere Systembits nach rechts
