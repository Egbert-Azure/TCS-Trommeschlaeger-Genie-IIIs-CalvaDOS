CD 9B 50    	CALL	m509b		;Screen full ?
18 E6       	JR	m4d28
            
3E 00       m4d42	LD	A,00h		;hier wird der Directory Entry Code gepatcht
            m4d43	EQU	$-1
32 00 00    m4d44	LD	(m4d43),A	;neuen DEC patchen (s.o.)
