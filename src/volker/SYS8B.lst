            m1916	EQU	1916h
            m4380	EQU	4380h
            m43a0	EQU	43a0h		;SYSTEM AN (DRIVE # für DIR)
            m4409	EQU	4409h		;DOS ERROR EXIT
            m492f	EQU	492fh		;FDE einer File aus dem Directory holen
            m4cd5	EQU	4cd5h		;Zeichen in (HL) testen
            	ORG	4d00h
FD 21 80 43 	LD	IY,m4380
