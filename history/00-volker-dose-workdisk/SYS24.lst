ED A3       	OUTI			;Pufferdatum auf das Register ausgeben
20 F9       	JR	NZ,m4f74	;bis 5 Register (bis WR5) geschr. sind
2B          	DEC	HL		;wird neues IX+0
E5          	PUSH	HL
DD E1       	POP	IX
