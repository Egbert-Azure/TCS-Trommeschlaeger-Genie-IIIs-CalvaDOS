23          	INC	HL
BE          	CP	(HL)		;richtige Baudrate gefunden?
23          	INC	HL		;auf nächsten Baudrate-String
20 F3       	JR	NZ,m4fc2	;falls noch nicht gefunden
EB          	EX	DE,HL		;HL <- ASCII-String der Baudrate
CD 94 4F    	CALL	m4f8a		;String anzeigen
CD 8F 4F    	CALL	m4f85		;Blank dahinter
DD 7E 03    	LD	A,(IX+03h)	;Puffer für Datenbits/Zeichen
07          	RLCA			;*2 für Rechnerei
CB 8F       	RES	1,A		;für Rechnerei (kein Wortlängen-Bit)
CB 7F       	BIT	7,A		;7 oder 8 Bits/Zeichen?
28 02       	JR	Z,m4fe2		;falls 5 oder 6, andernfalls:
CB CF       	SET	1,A		;min. 2, ergibt 7 oder 8 Datenbits
E6 03       m4fe2	AND	03h		;andere Bits maskieren
C6 35       	ADD	A,'5'		;A <- "7" oder "8" (Datenbits pro Zeich.)
CD 33 00    	CALL	m0033		;anzeigen
CD 8F 4F    	CALL	m4f85		;Blank dahinter
DD 7E 04    	LD	A,(IX+04h)	;Puffer für WR4
F5          	PUSH	AF
E6 0C       	AND	0ch		;Stopbit-Muster
20 08       	JR	NZ,m4ffc	;falls Stopbits programmiert
21 CB 50    	LD	HL,m50d3	;Text "?S?" (Sync-Mode nicht vorgesehen)
CD 67 44    	CALL	m4467		;anzeigen
18 15       	JR	m5011		;weiter mit anderen Parametern
            
FE 08       m4ffc	CP	08h		;1.5 Stopbits?
20 08       	JR	NZ,m5008	;falls nein
21 D6 4D    	LD	HL,m4dc9	;String "1.5"
CD 94 4F    	CALL	m4f8a		;String anzeigen
18 09       	JR	m5011		;weiter mit anderen Parametern
            
0F          m5008	RRCA			;Bits 2-3 -> Cy und Bit 0
0F          	RRCA
CB 3F       	SRL	A		;(Bit 7 muß sauber bleiben)
C6 31       	ADD	A,'1'		;ASCII Stop-Bits
CD 33 00    	CALL	m0033		;anzeigen
CD 8F 4F    m5011	CALL	m4f85		;Blank dahinter
F1          	POP	AF		;Inhalt von WR4
CB 47       	BIT	0,A		;Parity programmiert?
20 05       	JR	NZ,m501e	;falls ja
21 B9 4D    	LD	HL,m4dac	;sonst Text "NO"
18 0A       	JR	m5028		;anzeigen usw.
            
CB 4F       m501e	BIT	1,A		;parity even?
21 AC 4D    	LD	HL,m4d9f	;Text "EVEN"
20 03       	JR	NZ,m5028	;falls ja
21 B3 4D    	LD	HL,m4da6	;sonst Text "ODD"
CD 94 4F    m5028	CALL	m4f8a		;String anzeigen
CD 8F 4F    	CALL	m4f85		;Blank dahinter
DD 7E 02    	LD	A,(IX+02h)	;versch. Bits des Protokolls
21 DC 4D    	LD	HL,m4dcf	;Text "XON"
CB 7F       	BIT	7,A		;XON?
20 0A       	JR	NZ,m5042	;falls ja
21 E2 4D    	LD	HL,m4dd5	;Text "RTS"
CB 6F       	BIT	5,A		;RTS?
20 03       	JR	NZ,m5042	;falls ja
21 E8 4D    	LD	HL,m4ddb	;sonst Text "DTR"
F5          m5042	PUSH	AF
CD 94 4F    	CALL	m4f8a		;String anzeigen
CD 8F 4F    	CALL	m4f85		;Blank dahinter
F1          	POP	AF
21 EE 4D    	LD	HL,m4de1	;Text "WAIT"
CB 47       	BIT	0,A		;WAIT?
20 03       	JR	NZ,m5054	;falls ja
21 F5 4D    	LD	HL,m4de8	;sonst Text "NOWAIT"
CD 94 4F    m5054	CALL	m4f8a		;String anzeigen
DD CB 05 7E 	BIT	7,(IX+05h)	;PR-Flag?
28 09       	JR	Z,m5066		;falls nein
CD 8F 4F    	CALL	m4f85		;Blank dahinter
21 98 4D    	LD	HL,m4d8b	;Text "PR"
CD 94 4F    	CALL	m4f8a		;String anzeigen
3E 0D       m5066	LD	A,0dh		;CR
CD 33 00    	CALL	m0033		;ausgeben
DD 21 E5 42 	LD	IX,m42e5	;Parameterliste für Kanal B
05          	DEC	B		;Sprung zu weit für DJNZ
C2 A4 4F    	JP	NZ,m4f9a	;gegf. Parameter für Kanal B anzeigen
21 16 02    	LD	HL,m0216	;residenter Puffer für WR5, Kanal A
3A E5 42    	LD	A,(m42e5)	;dort stehen die Daten
77          	LD	(HL),A		;in den Puffer schreiben
23          	INC	HL		;auf 0217
DD 7E 05    	LD	A,(IX+05h)	;Puffer für WR5, Kanal B
77          	LD	(HL),A		;dort ablegen
06 02       	LD	B,02h		;Zähler für 2 Kanäle
3A E3 42    	LD	A,(m42e3)	;Datum von WR3, Kanal A
E6 C0       m5084	AND	0c0h		;Bits für die Wortlänge
0E FF       	LD	C,0ffh		;AND-Maske für empfangenes Byte
FE C0       	CP	0c0h		;8 Bits/Zeichen?
28 0E       	JR	Z,m509a		;falls ja
0E 7F       	LD	C,7fh
FE 40       	CP	40h		;7 Bits?
28 08       	JR	Z,m509a
0E 3F       	LD	C,3fh
FE 80       	CP	80h		;6 Bits?
28 02       	JR	Z,m509a
0E 1F       	LD	C,1fh		;bei 5 Bits/Zeichen
23          m509a	INC	HL		;auf 0218 (Kanal A) bzw. 0219 (Kanal B)
71          	LD	(HL),C		;AND-Maske puffern
DD 7E 03    	LD	A,(IX+03h)	;Datum von WR3, Kanal B
10 E3       	DJNZ	m5084		;bis Inhalt von WR3, Kan. A und B gepuff.
3A E2 42    	LD	A,(m42e2)	;Bitmuster für Protokoll, Kanal A
23          	INC	HL		;auf 021A
77          	LD	(HL),A		;puffern
DD 7E 02    	LD	A,(IX+02h)	;dto. Kanal B
23          	INC	HL		;auf 021B
77          	LD	(HL),A		;puffern
11 02 00    	LD	DE,0002h	;diskrelativer Sektor 2
21 00 42    	LD	HL,m4200	;Sektorpuffer
CD 40 46    	CALL	m4640		;Sektor neu schreiben
FE 0F       	CP	0fh		;Fehlercode "Diskette schreibgeschützt"?
20 01       	JR	NZ,m50ca	;falls anderer Fehler
AF          	XOR	A		;Flag "kein Fehler" bei Schreibschutz
DD E1       m50ca	POP	IX
C9          	RET			;zurück mit Fehlerstatus
            
53          m50ce	DEFM	'SIO ',03h	;Texte für Parameteranzeige der SIO
3F          m50d3	DEFM	'?S?',03h
            
            ;		Change Directory
            ;
            ;
            ;	Setzt Defaultlaufwerk nach Namens eingabe
            ;
            ;	RAMDISK		- LW# 3
            ;	DOS		- LW# 5
            ;	SOURCES		- LW# 6
            ;	WORKBENC	- LW# 7
            ;	DATEN		- LW# 8
            ;	SONSTIGES	- LW# 9
            ;	DISK0		- LW# 0
            ;	DISK1		- LW# 1
            ;
            ;
            dosrdy	EQU	402dh
            doserr	EQU	4409h
            gibaus	EQU	4467h
            dirlw	EQU	43a0h
            openlw	EQU	43a1h
            verglei	EQU	4cc5h
            
            	ORG	3000h		; muss hier stehen wegen Common
E5          chadir	PUSH	HL		; HL retten
D1          	POP	DE		; HL -> DE
01 48 51    	LD	BC,text0	; 'DISK0',00
CD C5 4C    	CALL	verglei
28 4C       	JR	Z,eintrag	; wenn text gleich, weiter
D5          	PUSH	DE
E1          	POP	HL
01 5A 51    	LD	BC,text1        ; 'DISK1',00
CD C5 4C    	CALL	verglei
28 42       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 6C 51    	LD	BC,text2	; 'RAMDISK',00
CD C5 4C    	CALL	verglei
28 38       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 7F 51    	LD	BC,text5	; 'DOS',00
CD C5 4C    	CALL	verglei		;
28 2E       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 93 51    	LD	BC,text6	; 'SOURCES',00
CD C5 4C    	CALL	verglei
28 24       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 A6 51    	LD	BC,text7	; 'WORKBENC',00
CD C5 4C    	CALL	verglei
28 1A       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 BB 51    	LD	BC,text8	; 'DATEN',00
CD C5 4C    	CALL	verglei
28 10       	JR	Z,eintrag
D5          	PUSH	DE
E1          	POP	HL
01 CC 51    	LD	BC,text9	; 'SONSTI',00
CD C5 4C    	CALL	verglei
28 06       	JR	Z,eintrag
3E 20       abgang	LD	A,20h		; 'unzulässiges od. Fehlendes LW'
B7          	OR	A
C3 09 44    	JP	doserr
0A          eintrag	LD	A,(BC)
32 A0 43    	LD	(dirlw),A	; lwnummern eintragen
32 A1 43    	LD	(openlw),A
            ;
            ; ab hier soll in bank 0 der name gepatcht werden, dessen laufwerks
            ; nummer gewählt wurde.
DB F9       	IN	A,(0f9h)	;sysport 0 ist der Bankingport
CB 87       	RES	0,A		; common unten
CB B7       	RES	6,A		; bank 0 anwählen
CB BF       	RES	7,A		;  dito
F3          	DI			; jetzt wirds heikel
D3 F9       	OUT	(0f9h),A	; diese Konfiguration ausgeben
03          	INC	BC		; bc muß um 5 erniedrigt werden
            	     		; um auf den Anfang von
            	 	  		; text(x)	zu zeigen
60          	LD	H,B		; wegen LDIR, source ist HL
69          	LD	L,C		; nicht wahr
            ; Hier steht die Adresse, die gegebenenfalls geändert werden muß
11 00 00    	LD	DE,90bbh	; ist in dem gebankten SYS1 der
            ; falls der Interpreter geändert wurde. Man muß mit dem Booteprom
            ; monitor sich die genaue Stelle in Bank 0 angucken. !!!
01 10 00    	LD	BC,0010h	; Bank 0 die adresse des DOS-Ready
ED B0       	LDIR			; strings, wird so gepatcht
3E 40       	LD	A,40h		; normale konfiguration von port
D3 F9       	OUT	(0f9h),A	; f9
FB          	EI
C9          	RET
44          text0	DEFM	'DI0',00,00,':0Disk_0 >',1eh,03
44          text1	DEFM	'DI1',00,01,':1Disk_1 >',1eh,03
00          text2	DEFM	'RAM',00,03h,':3Ramdisk >',1eh,03
44          text5	DEFM	'DOS',00,05,':5CalvaDOS >',1eh,03
53          text6	DEFM	'SOU',00,06,':6Sources >',1eh,03
57          text7	DEFM	'WOR',00,07,':7Workbench >',1eh,03
44          text8	DEFM	'DAT',00,08,':8Daten >',1eh,03
53          text9	DEFM	'SON',00,09,':9Sonstiges >',1eh,03
            	END	sys24
