90          	SUB	B		;A <- "A" oder "B"
CD 33 00    	CALL	m0033		;anzeigen
CD 8F 4F    	CALL	m4f85		;Blank dahinter
21 FE 4D    	LD	HL,m4df1	;Tabelle der Baudrates
3A E0 42    	LD	A,(m42e0)	;Baudrate-Puffer für beide Kanäle
05          	DEC	B		;noch Kanal A?
20 04       	JR	NZ,m4fb6	;falls schon Kanal B
0F          	RRCA			;ins untere Nibble rotieren
0F          	RRCA
0F          	RRCA
0F          	RRCA
04          m4fb6	INC	B		;Zähler restaurieren
