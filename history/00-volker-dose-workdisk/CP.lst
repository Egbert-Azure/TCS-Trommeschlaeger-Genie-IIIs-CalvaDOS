            ;	C o P y  mit  Wildcards (CP/CMD
            ;
            ;Kopieren von einer diskette auf eine andere
            ;mit angabe von wildcards
            ;	? = beliebiger buchstabe
            ;	* = nachfolgende zeichen bis '/' beliebig
            ;
            ;
            ;  Syntax :=  CP FILENAME/EXT:lw#,:lw# <ENTER>
            ;
            ;
            ; Änderungen 18.02.92 - bei */* sowohl 'j' als 'J' erlaubt
            ;		      - erkennung von SYS und Folgeeinträgen
            ;			geändert
            ;		      - nach der Extension auch blanks erlauben
            ;            14.03.92 - statt Komma auch ein blank zwischen den
            ;			Laufwerksnummern erlaubt
            ;			!!   Hallo Alexander   !!
            ;
            ;
            outch	EQU	0033h
            getkey	EQU	0049h
            dosrdy	EQU	402dh
            doscal	EQU	4419h
            extrfs	EQU	441ch
            sendms	EQU	4467h
            grosbu	EQU	45b5h
            dirr	EQU	490ah
            dirw	EQU	491fh
            tesdsk	EQU	445eh
            debug	EQU	440dh
            doserr	EQU	4409h
            ;
            ;
            	ORG	8000h
78          dri1	DEFM	'x'	;source-lw#
78          dri2	DEFM	'x'	;destination-lw#
78          secanz	DEFM	'x'	; anzahl der zu lesenden
            			; dirsectoren mit FDE's
78          buf1	DEFM	'xx'	; zeiger auf buffer
78          buf2	DEFM	'xx'	; zeigt auf anfang Bufferfeld
00          filzae	DEFM	00h	; Anzahl der zu kopierenden Files
46          fname	DEFM	'FILENAME';ebenso vom Progr. eingesetzt
45          exten	DEFM	'EXT'
0D          ende	DEFM      0DH     ;in den zurückliegenden 11 bytes
            			;wird der Vergleichsfilespec
            			;eingeschrieben um verglichen
            			;zu werden
53          schlech	DEFM	'Syntax := CP FILENAME/EXT'
3A          	DEFM	':<Lw#q>,:<Lw#z> <ENTER>'
0D          	DEFM	0dh     ; Bei falscher Eingabe
06 09       start	LD	B,09h	; max. 8Zeichen für Filename
11 08 80    	LD	DE,fname; Zeiger auf 		"
7E          loop1	LD	A,(HL)	; zeichen holen
CD B5 45    	CALL	grosbu	; a->A, soweit möglich
FE 3F       	CP	'?'	; wenn ja einfach eintragen
28 08       	JR	Z,wei1
FE 30       	CP	'0'
38 0B       	JR	C,kzeich; wenn Carry gesetzt, ist
            			;das Zeichen in der
            			;ASCII-Tabelle kleiner als 'A'
FE 7E       	CP	'ß'
30 07       	JR	NC,kzeich; bzw. es ist oberhalb von 'Z'
12          wei1	LD	(DE),A	; buchstaben eintragen
13          	INC	DE
23          	INC	HL	; zeiger einen weiter
10 EB       	DJNZ	loop1	; bis 8 Zeichen
18 65       	JR	error	; mehr als 8 !!
FE 3A       kzeich	CP	':'	; laufwerkstrennzeichen?
28 61       	JR	Z,error	; enter ohne ext ist unzulässig
FE 2F       	CP	'/'	; einziges zulässiges zeichen
28 06       	JR	Z,slash	; weiter im text
FE 2A       	CP	'*'	; jetzt wirds interessant
28 41       	JR	Z,stern	; mal sehen
18 57       	JR	error	; anderes zeichen !!
78          slash	LD	A,B	; wegen DJNZ
FE 00       	CP	0h	; 8tes Zeichen ?
C4 A7 80    	CALL	NZ,nulauf; ausnullen mit spaces
11 10 80    	LD	DE,exten ; zeiger auf extensionstring
06 04       ext	LD	B,04h	; höchstens drei Buchstaben !
23          loop2	INC	HL	; eingangs zähler ein weiter
7E          	LD	A,(HL)
CD B5 45    	CALL	grosbu	; selbe routine wie oben
FE 3F       	CP	'?'	;einfach weiter
28 0C       	JR	Z,wei2
FE 20       	CP	' '	; blank ?
28 08       	JR	Z,wei2	; ist schon o.K.
FE 41       	CP	'A'
38 0E       	JR	C,keexze; wenn enter, dann o.k.
FE 5B       	CP	'Ä'
30 0A       	JR	NC,keexze; dito
12          wei2	LD	(DE),A	; buchstabe eintragen
13          	INC	DE
10 E7       	DJNZ	loop2	; bis 3 Zeichen
FE 3A       	CP	':'	; 13. Zeichen LW-Doppelpunkt ?
20 2F       	JR	NZ,error; wenn nicht !!!!!!!!!!!
18 3F       	JR	kopie	; soweit in ordnung
FE 2A       keexze	CP	'*'	; mit ?? aufüllen
28 19       	JR	Z,stern1
FE 3A       	CP	':'
C4 C6 80    	CALL	NZ,error; jetzt folgt die LW#
CD A7 80    	CALL	nulauf
18 31       	JR	kopie
3E 20       nulauf	LD	A,' '	; space
12          fill	LD	(DE),A	; in fname eintragen
13          	INC	DE
10 FC       	DJNZ	fill
C9          	RET
3E 3F       stern	LD	A,'?'	; fuellbyte '?'
CD A9 80    	CALL	fill
23          	INC	HL	; müßte auf '/' zeigen
18 B9       	JR	slash
3E 3F       stern1	LD	A,'?'	; füllbyte
CD A9 80    	CALL	fill	; ausfüllen,
23          	INC	HL	; soll auf ':' zeigen
11 13 80    	LD	DE,ende	; aufs ende von fname
7E          	LD	A,(HL)	; zeichen holen
FE 3A       	CP	':'	; wegen LW#
20 02       	JR	NZ,error
18 12       	JR	kopie	; soll funktionieren
21 14 80    error	LD	HL,schlech
CD 67 44    	CALL	sendms	; error meldung ausgeben
C3 2D 40    	JP	dosrdy	; vorläufiger ausstieg
D6 30       istzahl	SUB	'0'	; ascii korrektur
38 F3       	JR	C,error
FE 0A       	CP	10
D8          	RET	C
18 EE       	JR	error
23          kopie	INC	HL	; jetzt wird erst mal auf
            			; die Befehlssyntax
7E          	LD	A,(HL)	; also :lw#,:lw# getestet
CD CF 80    	CALL	istzahl
32 00 80    	LD	(dri1),A; als	source laufwerk
23          	INC	HL	; auf komma
7E          	LD	A,(HL)
FE 2C       	CP	','
28 04       	JR	Z,komma ; keine andere eingabe erlaubt
FE 20       	CP	' '	; außer einem <SPACE>
20 DC       	JR	NZ,error
23          komma	INC	HL	; auf zweiten doppelpunkt
7E          	LD	A,(HL)
FE 3A       	CP	':'
20 D6       	JR	NZ,error
23          	INC	HL	; auf destination laufwerk
7E          	LD	A,(HL)
CD CF 80    	CALL	istzahl
32 01 80    	LD	(dri2),A; als dest-lw
23          	INC	HL	; auf ENTER
7E          	LD	A,(HL)
FE 0D       	CP	0dh
20 C8       	JR	NZ,error;
            ; weiter im text, die Engabe ist richtig
            ; und der vergleichs filename steht.
            ; die laufwerksnummern sind auch da,
            ; jetzt kann wirklich kopiert werden.
            ; es werden ersteinmal die einträge in den
            ; buffer geschrieben
21 6D 83    	LD	HL,buffer
22 03 80    	LD	(buf1),HL
22 05 80    	LD	(buf2),HL; anfang des Buffers
            			 ; muss erhalten bleiben
3A 00 80    reasec	LD	A,(dri1); sourcelaufwerk eintragen
CD 5E 44    	CALL	tesdsk	; disketten zugriff testen
C2 09 44    	JP	NZ,doserr
CD DC 81    	CALL	ermi	; wieviele Dir-sectoren
3A 02 80    	LD	A,(secanz)
47          	LD	B,A
3E 01       	LD	A,1	; erster dir-sector mit fde's
3C          liesec	INC	A	; ist der Sector Nummer 2
F5          	PUSH	AF	; retten !!
C5          	PUSH	BC	; ebenso
CD 0A 49    	CALL	dirr	; les einen sector in DOS-buffer
FE 06       	CP	06h	;'Lesevers. markierter satz'
28 03       	JR	Z,wei3	; dann ist alles in ordnung
C3 09 44    	JP	doserr	; es ist ein fehler aufgetr.
CD 30 81    wei3	CALL	auswert	; gültige filespecs errech.
C1          	POP	BC
F1          	POP	AF	; accu vom stack als zähler
10 EC       	DJNZ	liesec
C3 EA 81    	JP	copy	; jetzt kann es richtig losgehen
06 07       auswert	LD	B,7	; acht eintäge pro sector
21 00 42    	LD	HL,4200h; erstes byte zeigt ob
            			; ein Eintrag vorhanden ist
11 05 42    	LD	DE,4205h; zeigt auf ersten FILENAMEEXT
CD 49 81    	CALL	verglei	; prüft ob der eintrag den
3E 20       loop3  LD	A,20h	; spezifikationen
85          	ADD	A,L     ; entspricht. Ein FDE ist
6F          	LD	L,A     ; 20h Byte lang.
3E 20       	LD	A,20h
83          	ADD	A,E
5F          	LD	E,A
CD 49 81    	CALL	verglei	; siehe 8 Zeilen weiter oben
10 F3       	DJNZ	loop3
C9          	RET		; acht einträge sind geprüft
E5          verglei	PUSH	HL	; HL und DE werden gerettet
D5          	PUSH	DE
C5          	PUSH	BC	; muß auch gertettet werden
06 0B       	LD	B,0bh	; 11 zeichen ist fname lang
7E          	LD	A,(HL)	; sehen ob eintrag besteht
FE 00       	CP	00h	; null, wenn nicht
28 69       	JR	Z,zurü	; erst noch pop de und hl
CB 7F       	BIT	7,A	; ist es ein Folgeeintrag ???
20 65       	JR	NZ,zurü	; dann nicht eintragen !!
CB 77       	BIT	6,A	; bit 6 ist '1' bei /SYS-Files
20 61       	JR	NZ,zurü	; weil die nicht kopiert
            			; werden dürfen (oder sollen)
            			; vor allen Dingen nicht Boot und
            			; Inhalt/SYS !!!!!!!!!!!!!!!!!!
21 08 80    	LD	HL,fname; enthält spezifizierten fname
1A          wei4 LD	A,(DE)	; zeichen im buffer
BE          	CP	(HL)	; vergleiche (hl) mit (de)
20 73       	JR	NZ,wei7 ; wenn nicht gleich, prüfen ob ?
23          wei5 INC	HL
13          	INC	DE	; zeiger auf nächstes zeichen
10 F8       	DJNZ	wei4 	; 11 zeichen vergleichen
00          eintr	NOP		; alle zeichen entsprechen den
            			; spezifikationen, jetzt müssen
            			; sie in einen Buffer
            			; eingetragen werden, allerdings
            			; in der Form FILENAME/EXT
7B          	LD	A,E	; DE muß um 11 erniedriegt werden
D6 0B       	SUB	11	; damit DE wieder auf Anfang des
5F          	LD	E,A	; filespecs im FDE zeigt
3A 07 80    	LD	A,(filzae); zähler für zu kop. Files
3C          	INC	A	; + 1
32 07 80    	LD	(filzae),A	; und speichern
2A 03 80    	LD	HL,(buf1); buf1 ist der zeiger auf buffer
CD C0 81    	CALL	ein>	; der DOS-Befehl '> 'wird
            			; vor die filespecs
            			; eingetragen wegen doscall
06 08       	LD	B,8	; acht zeichen höchstens
1A          loop4 LD	A,(DE)	; erstes zeichen im buffer
FE 20       	CP	' '	; ist es space ?
28 02       	JR	Z,nein
77          	LD	(HL),A	; zeichen eintragen
23          	INC	HL
13          nein	INC	DE	; zeiger weiter
10 F6       	DJNZ	loop4 	; bis 8 zeichen
3E 2F       	LD	A,'/'
77          	LD	(HL),A	; Trennzeichen eintragen
23          	INC	HL
06 03       ext2	LD	B,3	; 3 extension zeichen
1A          loop5 LD	A,(DE)	; erstes zeichen
FE 20       	CP	' '
28 02       	JR	Z,nein2
77          	LD	(HL),A
23          	INC	HL
13          nein2	INC	DE
10 F6       	DJNZ	loop5
2B          	DEC	HL	; abfrage, ob gar keine extension
7E          	LD	A,(HL)	; vorhanden war, dann muß der '/'
FE 2F       	CP	'/'	; nämlich auch wieder weg
28 01       	JR	Z,wei6
23          	INC	HL
3E 3A       wei6 LD	A,':'	; die zeichen ':lw#,:lw#',0dh
77          	LD	(HL),A	; werden hinter jeden filenamen
23          	INC	HL	; eingetragen
3A 00 80    	LD	A,(dri1)
C6 30       	ADD	A,48	; ascii-ausgleich !! accu+48d
77          	LD	(HL),A  ; dann wird aus 01h 49h,'A' !!
23          	INC	HL
3E 2C       	LD	A,','
77          	LD	(HL),A
23          	INC	HL
3E 3A       	LD	A,':'
77          	LD	(HL),A
23          	INC	HL
3A 01 80    	LD	A,(dri2) ; destination drive
C6 30       	ADD	A,48	; ascii-ausgleich !!!!!!!!!!
77          	LD	(HL),A
23          	INC	HL
3E 0D       	LD	A,0dh	; ENTER kennung für COPY befehl
77          	LD	(HL),A	; eintragen
23          	INC	HL	; zeigt auf das zeichen nach 0dh
22 03 80    	LD	(buf1),HL	; buf1 aktualisieren
            ; der filename wurde in den buffer eingetragen
            ; es wird eine ebene zurück gesprungen, ob der
            ; nexte eintrag gültig ist.
C1          zur}	POP	BC	; die parameter werden
D1          	POP	DE	; zurückgepopt
E1          	POP	HL
C9          	RET
            ; die Routine ein> fügt den GDOS-Befehl '> '
            ; also 'COPY ' ein.
            ; HL zeigt auf den Buffer
3E 00       ein>	LD	A,'>'
77          	LD	(HL),A
23          	INC	HL
3E 20       	LD	A,' '
77          	LD	(HL),A
23          	INC	HL
C9          	RET
3E 3F       wei7 LD	A,'?'	; test ob der joker gestzt ist
BE          	CP	(HL)	; vergleiche mit fname
28 88       	JR	Z,wei5 	; wenns ein '?' war, ist der
            			; Buchstabe o.K., ansonsten
18 E0       	JR	zurü	; braucht fname nicht weiter
            			; getestet werden, er entspricht
            			; nicht
            			; der geforderten Spezifikation
3E 01       ermi	LD	A,1	; im ersten sektor des dir
CD 0A 49    	CALL	dirr
3A 1F 42    	LD	A,(421fh); an dem byte 1fh befindet sich
C6 08       	ADD	A,08h	; die angabe , wieviele fde-
            			; sectoren das directory
            			; enthält.
32 02 80    	LD	(secanz),A	; speichern
C9          	RET
            ;
            ;	Jetzt folgt der eigentliche Kopiervorgang
            ;	es wird vorher getestet auf anzahl der Files = 	0
            ;	und auf */*, also kopiere alles
            ;	außerdem wird nach dem letzten Eintrag als
            ;	Endemarkierungein 'E' eingesetzzt
            ;
3E 45       copy	LD	A,'E'		; Endemarkierung
77          	LD	(HL),A		; nach dem letzten Befehl
3A 07 80    	LD	A,(filzae)	; keine Files  kopieren ?
FE 00       	CP	00h
28 34       	JR	Z,keifil	; Programm beenden
            				; vorher Meldung ausgeben
3A 1B 43    	LD	A,(431Bh)	; erstes Zeichen nach
            				; 'KOPIERE '
FE 2A       	CP	'*'		; falls '*/* folgt
20 36       	JR	NZ,goon
3A 1C 43    	LD	A,(431Ch)
FE 2F       	CP	'/'
20 2F       	JR	NZ,goon
3A 1D 43    	LD	A,(431Dh)
FE 2A       	CP	'*'
20 28       	JR	NZ,goon
21 C9 82    	LD	HL,meld1
CD 67 44    	CALL	sendms
21 E1 82    	LD	HL,meld2
CD 67 44    	CALL	sendms
CD 49 00    	CALL	getkey
FE 6A       	CP	'j'
28 05       	JR	Z,jaJA
FE 4A       	CP	'J'
C2 2D 40    	JP	NZ,dosrdy
3E 0D       jaJA	LD	A,0dh	; noch ein ENTER ausgeben
CD 33 00    	CALL	outch	; auf dem bildschirm ausgeben
18 09       	JR	goon
21 FB 82    keifil	LD	HL,meld3 ; kein File der Source-Disk
            			 ; entspricht den
CD 67 44    	CALL	sendms   ; geforderten Spezifikationen
C3 2D 40    	JP	dosrdy
2A 05 80    goon	LD	HL,(buf2)	; anfang des Buffers
CD 67 44    wei8    CALL	sendms	; der Copy-Befehl wird auf dem
            			; Bildschirm angezeigt.
2A 05 80    	LD	HL,(buf2)
CD 19 44    	CALL	doscal  ; der Befehl wird ausgeführt
C4 68 82    	CALL	NZ,keinfe; falls ein Fehler aufgetr. ist
3A 40 38    	LD	A,(3840h)	; tastaturzeile mit BREAK
CB 57       	BIT	2,A       ; Abbrechen mit <BREAK>-Taste
28 05       	JR	Z,wei9
3E 39       	LD	A,39h	; fehler 'Function Aborted'
C3 09 44    	JP	doserr
            ; Suchroutine um den nächsten Befehl zu finden
2A 05 80    wei9    LD	HL,(buf2); anfang des letzten Befehls
06 00       	LD	B,0
0E 09       	LD	C,9; der nächste Befehl kommt frühestens
09          	ADD	HL,BC		; nach 9 Zeichen.
7E          loop6 LD	A,(HL)
FE 0D       	CP	0dh	; kommt schon der nächste ?
28 03       	JR	Z,wei10
23          	INC	HL		; zeiger ein weiter
18 F8       	JR	loop6 		; ohne ende .
23          wei10	INC	HL		; ein hamwa noch
7E          	LD	A,(HL)
FE 3E       	CP	'>'		; normaler Befehl ?
C2 2D 40    	JP	NZ,dosrdy  ;  wenn nicht, wars der letzte
22 05 80    	LD	(buf2),HL  ; buf2 zeigt auf den nächsten
18 CC       	JR	wei8	;Befehl und so weiter und so fort
FE 1A       keinfe	CP	1ah	; fehlermeldung 'Directory voll'
28 0F       	JR 	Z,loefil; letzten File wieder loeschen
FE 1B       	CP	1bh	; 'Diskette voll '	??????
28 0B       	JR	Z,loefil
FE 1E       	CP	1eh	; 'Directory voll bei Erw. ' ??
28 07       	JR	Z,loefil
FE 21       	CP	21h	; 'Kein Platz auf Diskette ' ??
28 03       	JR	Z,loefil
C3 09 44    	JP	doserr
21 26 43    loefil	LD 	HL,4326h; letztes (moegliches)
            			; signifikantes
            			; Zeichen des Copy-Befehls
11 29 43    	LD	DE,4329h	; die ganze Zeichenkette
            				; soll um 3 Zeichen nach
            				;hinten verschoben werden
01 0D 00    	LD	BC,000dh	; sie ist 14 Zeichen lang
            				; und zwar 'Filename/Ext'
            				; + <ENTER> + ein blank
            				; nach dem '>' !!
ED B8       	LDDR			; verschiebebefehl
            				; (Mit DEC der Parameter !)
21 C4 82    	LD	HL,kill		; source ist 'KILL '
11 18 43    	LD	DE,4318h	; Anfang  Befehlsbuffer
01 05 00    	LD	BC,0005h	; übertrage 5 Zeichen
ED B0       	LDIR			; also los
EB          	EX	DE,HL		; Austausch HL <> DE
23          findde	INC	HL		; suche den Doppelpunkt
            				; für Destination
7E          	LD	A,(HL)		; Drive Eintrag
FE 3A       	CP	':'
20 FA       	JR	NZ,findde	;solange bis ':' gefunden
23          	INC	HL		; zeiger auf Drive-#
3A 01 80    	LD	A,(dri2)	; Destination-Drive
C6 30       	ADD	A,'0'		; ASCII-Ausgleich
77          	LD	(HL),A		; eintragen
23          	INC	HL
3E 0D       	LD	A,0dh		;<cr> am Schluß eintragen
77          	LD	(HL),A
21 18 43    	LD	HL,4318h	; Befehlsbuffer des DOS
CD 67 44    	CALL	sendms		; auf Display anzeigen
21 18 43    	LD	HL,4318h
CD 19 44    	CALL	doscal		; ausführen
CA BB 82    	JP	Z,noerr  	; zurück ins DOS
21 24 83    	LD	HL,meld4	; ansonsten Fehlermeldung
CD 67 44    	CALL	sendms		; ausgeben
C3 2D 40    	JP	dosrdy		; und zurueck ins DOS
21 58 83    noerr	LD	HL,meld5	; 'Diskette voll' ausg.
CD 67 44    	CALL	sendms
C3 2D 40    	JP	dosrdy
4B          kill	DEFM	'KILL '		; DOS-BEFEHL KILL
41          meld1	DEFM	'Alle Dateien kopieren? ',03h
42          meld2	DEFM	'Bitte mit <J> bestätigen ',0dh
4B          meld3	DEFM	'Keine Files der Spezifikation '
76          	DEFM	'vorhanden.',0dh
44          meld4	DEFM	'Der letzte kopierte File muss '
6E          	DEFM	'noch gelöscht werden.',0dh
44          meld5	DEFM	'Diskette voll !!!!!!',0dh
            buffer	EQU	$
            	END	start
