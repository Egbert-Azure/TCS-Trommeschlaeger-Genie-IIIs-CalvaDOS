28 29       	JR	Z,m4d5b
            	IF	new
FE 23       	CP	23h	;Aufruf aus SYS1 und 4400: DOS-Ready
28 54       	JR	Z,m4d8a
            	ENDIF
            ;beim Requestcode E3 bestimmt der Entry-Zähler die Zieladresse:
