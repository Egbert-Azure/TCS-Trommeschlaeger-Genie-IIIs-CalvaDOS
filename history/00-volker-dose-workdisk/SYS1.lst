38 06       	JR	C,m4f3e		;falls nein (kleineres Zeichen, z. B. CR)
28 1B       	JR	Z,m4f55		;falls ja
0D          	DEC	C		;Zeichenzähler herunterzählen
13          	INC	DE		;auf nächstes Zeichen stellen
10 F1       	DJNZ	m4f2f		;max. 9 Zeichen prüfen (Name + CR)
23          m4f3e	INC	HL		;Pufferzeiger weiterstellen
23          	INC	HL
E5          	PUSH	HL
EB          	EX	DE,HL		;HL <- Befehlszeiger
06 00       	LD	B,00h		;MSB = 00
09          	ADD	HL,BC		;HL <- Ende des Befehls
54          	LD	D,H		;nach DE
5D          	LD	E,L
2B          	DEC	HL		;Stelle davor
13          	INC	DE		;3 Stellen dahinter
13          	INC	DE
13          	INC	DE
ED B8       	LDDR			;Filenamen um 4 Stellen weiterschieben
E1          	POP	HL		;Pufferzeiger
0E 03       	LD	C,03h		;3 Zeichen für EXT
ED B8       	LDDR			;EXT einkopieren
3E 2F       	LD	A,'/'		;Trennzeichen davor
12          	LD	(DE),A		;hinter den Filenamen
C1          m4f55	POP	BC		;restaurieren
D1          	POP	DE
C9          	RET
            
            ;	Tabelle der LIB-Befehle
            ;
            ;	1. Byte:	Bit 7 als Endmarkierung des Befehlsworts
            ;			Bit 6=1: unter Mini-DOS nicht erlaubt
            ;			Rest: Entry-Counter
            ;	2. Byte:	Request-Code für RST28 (Zeiger auf SYS-File)
            ;	3. Byte:	Bit 0=1: /CMD anfügen
            ;			Bit 1=1: /JOB anfügen
            ;			Bit 4=1: Ende prüfen
            ;			Bit 5=1: 2 Filespec auswerten
            ;			Bit 6=1: neues File öffnen
            ;			Bit 6=0: File öffnen
            ;			Bit 7=1: Overlay laden
            
41          cmdtab	DEFM	'AIK',80h,53h,00h
41          	DEFM	'APPEND',0c0h,68h,00h
41          	DEFM	'ATTRIB',85h,0e9h,88h
41          	DEFM	'AUTO',84h,0e9h,00h
            	IF	NOT,new
42          	DEFM	'B2',86h,0ebh,00h
            	ENDIF
42          	DEFM	'BL',81h,0e5h,00h
42          	DEFM	'BOOT',8ah,0ebh,10h
42          	DEFM	'BREAK',85h,0e5h,00h
            	IF	new			; CD Change Directory eingefügt
43          	DEFM	'CD',82h,0fah,00        ; in SYS24/SYS
            	ENDIF
43          	DEFM	'CLS',80h,0a6h,00h
43          	DEFM	'CONT',0c5h,0ebh,00h
            	IF	NOT,new
43          	DEFM	'COPY',0c0h,48h,00h
            	ENDIF
43          	DEFM	'CREATE',82h,0f0h,40h
44          	DEFM	'DATUM',8bh,0e9h,00h
44          	DEFM	'DDE',81h,0f1h,00h
            	IF	NOT,new
44          	DEFM	'DIR',80h,2ah,00h
            	ENDIF
44          	DEFM	'DISK',83h,0ffh,00h
44          	DEFM	'DO',0c3h,0ebh,8ah
44          	DEFM	'DR',82h,0feh,00h
44          	DEFM	'DUMP',87h,0e9h,0c8h
45          	DEFM	'E',87h,0f0h,00h
46          	DEFM	'FORM',88h,0feh,00h
46          	DEFM	'FREE',80h,4ah,00h
46          	DEFM	'F#',80h,0fbh,00h
            	IF	new
48          	DEFM	'H',84h,0ffh,00h      ;neu von Volker
            	ENDIF
48          	DEFM	'HIMEM',82h,0e9h,00h
49          	DEFM	'I',80h,2ah,00h
49          	DEFM	'INFO',81h,0ffh,00h
4A          	DEFM	'JKL',80h,7ch,10h
4B          	DEFM	'KILL',80h,45h,90h
4C          	DEFM	'LC',88h,0e5h,00h
4C          	DEFM	'LF',81h,0feh,00h
            	IF	NOT,new
4C          	DEFM	'LIB',82h,0e3h,00h
            	ENDIF
4C          	DEFM	'LIST',85h,0f0h,88h
4C          	DEFM	'LOAD',80h,0a4h,50h
4D          	DEFM	'M>',82h,0ebh,0b0h
4E          	DEFM	'N',81h,0e4h,0b0h
4E          	DEFM	'NDF',0c0h,28h,00h
            	IF	new
4F          	DEFM	'ON',85h,0ffh,00h	;HRG-Schirm ein
4F          	DEFM	'OFF',86h,0ffh,00h	;HRG-Schirm aus
50          	DEFM	'PARK',87h,0ffh,00h	;Park Harddisk
            	ENDIF				; neu von Volker
50          	DEFM	'PAUSE',88h,0ebh,00h
50          	DEFM	'PD',83h,0e9h,00h
50          	DEFM	'PIO',80h,9ch,00h
50          	DEFM	'PORT',82h,0ffh,00h
50          	DEFM	'PRINT',86h,0f0h,88h
50          	DEFM	'PROT',86h,0e9h,00h
50          	DEFM	'PURGE',89h,0e9h,00h
52          	DEFM	'R',80h,23h,00h
53          	DEFM	'S',81h,0e9h,00h
            	IF	NOT,new
53          	DEFM	'SIO',80h,0bch,00h
            	ENDIF
            	IF	new			; geänderte SIO-Routine
53          	DEFM	'SIO',81h,0fah,00h	; jetzt in SYS24
            	ENDIF
53          	DEFM	'STMT',89h,0ebh,00h
            	IF	new
53          	DEFM	'SYS',80h,86h,00h
            	ENDIF
55          	DEFM	'UHR',82h,0e5h,00h
56          	DEFM	'V+',84h,0e5h,00h
5A          	DEFM	'Z',81h,0f8h,00h
5A          	DEFM	'ZEIT',8ah,0e9h,00h
5A          	DEFM	'ZL',82h,0f8h,88h
30          	DEFM	'0',84h,0f0h,00h
36          	DEFM	'64',81h,98h,00h
38          	DEFM	'80',82h,98h,00h
21          	DEFM	'!',83h,0ebh,8ah
23          	DEFM	'##',83h,98h,00h
26          	DEFM	'&',83h,0e5h,00h
40          	DEFM	'@',81h,0f0h,00h
            ;	{D5}	';',86h,0e3h,00h
2F          	DEFM	'/',85h,0e3h,00h
3E          	DEFM	'>',0c0h,48h,00h
3F          	DEFM	'?',82h,0e3h,00h
00          	DEFB	00h			;Kenner für Ende der Tabelle
            	IF	NOT,new
00          	DEFB	00h
            	ENDIF
            
            ;Befehl LIB bwz. ?
21 39 4F    m50cf	LD	HL,cmdtab	;DOS-Befehlstabelle
            	IF	NOT,new
0E 40       m50d2	LD	C,40h		;Zähler 63 Befehle + Nullbytes
            	ENDIF
06 08       m50d4	LD	B,08h		;8 Bildschirmstellen Platz pro Befehl
7E          m50d6	LD	A,(HL)		;Zeichen des Befehls laden
CB 7F       	BIT	7,A		;hinter dem Befehlswort?
23          	INC	HL		;nächste Stelle
20 05       	JR	NZ,m50e1	;falls Befehlswort vollständig angezeigt
CD 94 51    	CALL	m51b7		;Zeichen des Befehls anzeigen
10 F5       	DJNZ	m50d6		;Befehl komplett anzeigen, Restplatz in B
23          m50e1	INC	HL		;Requestcode usw. überspringen
23          	INC	HL
7E          	LD	A,(HL)		;laden
B7          	OR	A		;=00?
CA 92 51    	JP	Z,m51b5		;LF ausgeben und Ende, falls ja
            	IF	NOT,new
0D          	DEC	C		;Zähler herunterzählen
CC B5 51    	CALL	Z,m51b5		;LF ausgeben, falls Zähler abgelaufen
28 E4       	JR	Z,m50d2		;dort weiter, falls Zähler abgelaufen
            	ENDIF
CD 89 51    	CALL	m51ad		;Blanks bis zur nächst. Achterstelle anz.
18 E7       	JR	m50d4		;und von vorne
            
            ;Einsprung für Mini-DOS
F3          m50f3	DI
CD 1F 51    	CALL	pushreg		;alle Register retten
21 6A 43    	LD	HL,m436a	;div. Flags
7E          	LD	A,(HL)		;laden
E6 C0       	AND	0c0h		;Mini-DOS oder DOS-CALL aktiv?
20 2E       	JR	NZ,m5132	;Ende, falls ja
3A 22 40    	LD	A,(m4022)	;Flag für Cursorstatus im DCB
F5          	PUSH	AF		;Status retten
ED 73 9B 43 	LD	(m439b),SP	;Stack retten
CB FE       	SET	7,(HL)		;Flag setzen: Mini-DOS aktiv
            	IF	NOT,new
FB          	EI
3E 0B       	LD	A,0bh		;LF
CD 33 00    	CALL	m0033		;ausgeben
            	ENDIF
            	IF	new
CD 91 51    	CALL	m51b4		;LF anzeigen
            	ENDIF
C3 6F 4D    	JP	m4d8a		;dort weiter (Mini-DOS-Ready)
            
            ;Einsprung nach ; bzw. MDRET
21 6A 43    m5112	LD	HL,m436a	;versch. Flags
CB 7E       	BIT	7,(HL)		;ist Mini-DOS aktiv?
CA 3C 4D    	JP	Z,illfnct	;falls nein
ED 7B 9B 43 	LD	SP,(m439b)	;Stack restaurieren
            	IF	NOT,new
3E 0E       	LD	A,0eh		;Code für Cursor an
CD 33 00    	CALL	0033h		;ausgeben
            	ENDIF
F1          	POP	AF		;alter Cursorstatus
B7          	OR	A		;war er an?
47          	LD	B,A		;retten
3E 0F       	LD	A,0fh		;Code Cursor aus
            	IF	NOT,new
CC 33 00    	CALL	Z,m0033		;ausgeben, falls er aus war
            	ENDIF
            	IF	new
28 01       	JR	Z,dspcurs	;ausgeben, falls er aus war
3D          	DEC	A		;A <- 0E, Code für Cursor an
CD 33 00    dspcurs	CALL	0033h		;Cursor an/ausschalten
            	ENDIF
78          	LD	A,B		;Cursorstatus
32 22 40    	LD	(m4022),A	;restaurieren
F3          	DI
CB BE       	RES	7,(HL)		;Flag: Mini-DOS nicht mehr aktiv
AF          m5132	XOR	A		;Flag "kein Fehler"
08          popreg	EX	AF,AF'		;alle Register restaurieren
FD E1       	POP	IY
DD E1       	POP	IX
F1          	POP	AF
C1          	POP	BC
D1          	POP	DE
E1          	POP	HL
D9          	EXX
C1          	POP	BC
D1          	POP	DE
E1          	POP	HL
08          	EX	AF,AF'
FB          	EI
C9          	RET
F1          pushreg	POP	AF		;RET-Adresse zwischenpuffern
E5          	PUSH	HL		;alle Register retten
D5          	PUSH	DE
C5          	PUSH	BC
08          	EX	AF,AF'
D9          	EXX
E5          	PUSH	HL
D5          	PUSH	DE
C5          	PUSH	BC
F5          	PUSH	AF
DD E5       	PUSH	IX
FD E5       	PUSH	IY
D9          	EXX
08          	EX	AF,AF'
F5          	PUSH	AF		;RET-Adresse zurück
C9          	RET			;diese anspringen
            
            ;Filespec. von (HL) nach (DE) übertr. und HL auf EOS (03 oder CR) stellen
CD 44 51    m5155	CALL	m5168		;Befehl in den FCB schreiben
F5          	PUSH	AF		;retten
7E          	LD	A,(HL)		;Zeichen des Befehls
D6 03       	SUB	03h		;EOS?
28 05       	JR	Z,m5163		;falls ja
D6 0A       	SUB	0ah		;CR?
28 01       	JR	Z,m5163		;falls ja
23          	INC	HL		;nächstes Zeichen
F1          m5163	POP	AF		;restaurieren
C9          	RET
            
11 80 44    m5165	LD	DE,m4480	;FCB
D5          m5168	PUSH	DE		;Adresse retten
06 20       	LD	B,20h		;max. 32 Zeichen
CD 4E 51    	CALL	m5172		;Programmnamen in den FCB übertragen
D1          	POP	DE
06 00       	LD	B,00h		;LRL = 256
C9          	RET
7E          m5172	LD	A,(HL)		;Zeichen des Befehlsstrings
FE 2A       	CP	'*'		;für Benutzerroutinen?
20 04       	JR	NZ,m517b	;falls nein
12          	LD	(DE),A		;Zeichen im FCB ablegen
13          	INC	DE		;nächste Stelle
23          	INC	HL		;nächstes Zeichen des Befehls
05          	DEC	B		;1 Zeichen weniger max. erlaubt
E5          m517b	PUSH	HL		;retten
7E          	LD	A,(HL)		;Zeichen des Befehls
D6 30       	SUB	'0'		;falls Ziffer: binär
FE 0A       	CP	0ah		;evtl. Buchstabe?
CD 7D 51    	CALL	m51a1		;auf Ziffer oder Buchstaben prüfen
30 16       	JR	NC,m519c	;falls unerlaubtes Zeichen
7E          m5186	LD	A,(HL)		;Zeichen des Befehls
D6 2E       	SUB	2eh
FE 0D       	CP	0dh		;war es ':'?
CD 7D 51    	CALL	m51a1		;auf ':' und Buchstaben prüfen
38 06       	JR	C,m5196		;weitermachen, falls erlaubtes Zeichen
3E 03       	LD	A,03h		;sonst EOS (String abschließen)
12          	LD	(DE),A		;in den FCB
F1          	POP	AF		;Stack bereinigen
AF          	XOR	A		;Z-Flag setzen (kein Fehler)
C9          	RET
7E          m5196	LD	A,(HL)		;Zeichen des Befehls
12          	LD	(DE),A		;in den FCB
13          	INC	DE		;nächste Stelle im FCB
23          	INC	HL		;dto. im Befehl
10 EA       	DJNZ	m5186		;bis B Zeichen abgelegt sind
F6 01       m519c	OR	01h		;NZ-Flag bei mehr als falscher Eingabe
E1          	POP	HL		;Befehlszeiger
7E          	LD	A,(HL)		;Zeichen laden
C9          	RET
D8          m51a1	RET	C		;falls nicht Buchstabe, Ziffer oder ':'
7E          	LD	A,(HL)		;Zeichen noch einmal laden
D6 41       	SUB	'A'		;Großbuchstabe?
FE 1F       	CP	1fh		;oder Kleinbuchstabe?
D8          	RET	C		;falls Großbuchstabe
D6 20       	SUB	20h		;Klein- zu Großbuchstaben machen
FE 1F       	CP	1fh		;noch höheres Zeichen?
C9          	RET			;zurück mit Flag
3E 20       m51ad	LD	A,' '		;Blank
CD 94 51    m51af	CALL	m51b7		;anzeigen
10 FB       	DJNZ	m51af		;B-mal
C9          	RET
            	IF	new
FB          m51b4	EI			;INTs wieder zulassen
            	ENDIF
3E 0B       m51b5	LD	A,0bh		;LF
D5          m51b7	PUSH	DE		;retten
            	IF	NOT,new
F5          	PUSH	AF
            	ENDIF
CD 33 00    	CALL	m0033		;Akku anzeigen
            	IF	NOT,new
F1          	POP	AF
            	ENDIF
D1          	POP	DE
C9          	RET			;zurück
43          defext	DEFM	'CMD'
4A          	DEFM	'JOB'
54          to	DEFM	'TO',00h
            	IF	NOT,new
4D          minprpt	DEFM	'Mini-'
42          dosprpt	DEFM	'Befehlseingabe',1eh,0dh
1C          m51f2	DEFB	1ch,1fh,03h	;Codes zum Löschen des Bildschirms
            	ENDIF
            	IF	new
4D          minprpt	DEFM	'M - '
            	LIST {A1}
            ;	Die Position des Dosready ist wichtig für den DOS
            ;	Befehl CD. Wenn SYS1/SYS in Bank 0 gepuffert ist
            ;	erechnet sich die Adresse wir folgt :
            ;	In Zeus := B 3f14h+dosprpt
            ;
3A          dosprpt	DEFM	':7Workbench >',1eh,03h
            ;
            	LIST {A0}
20          	DEFM	'    '	;WICHTIG FÜR DEN CD-BEFEHL, WEIL SONST DIE
            			; ENDE-KENNUNG DES FILES ÜBERSCHRIEBEN WIRD
            			;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
            	ENDIF
            fcb	EQU	51e0h
            	END	sys1
